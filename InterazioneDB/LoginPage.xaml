<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="SimulazioneApp.LoginPage">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Entry x:Name="txtEmail" Placeholder="Email" Keyboard="Email"/>
        <Entry x:Name="txtPwd" Placeholder="Password" IsPassword="True"/>
        <Button Text="Login" Clicked="OnLoginClicked"/>
        <Label x:Name="lblResult" TextColor="Red" />
    </VerticalStackLayout>
</ContentPage>